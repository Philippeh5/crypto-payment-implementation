{
  "name": "crypto-payment-starter-kit",
  "version": "1.0.0",
  "description": "Educational reference implementation of a non-custodial crypto payment gateway for EVM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "crypto",
    "payment",
    "gateway",
    "evm",
    "bip44",
    "usdc",
    "base",
    "ethereum",
    "starter-kit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.21.0",
    "zod": "^3.23.0",
    "pg": "^8.12.0",
    "dotenv": "^16.4.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "@scure/bip32": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}